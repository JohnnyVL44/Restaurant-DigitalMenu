---
interface Props {
    name: string;
    description: string;
    price: number;
    image: string;
    category: string;
}

const { name, description, price, image, category} = Astro.props
---

<article
    data-category={category}
    class="overflow-hidden rounded-2xl border border-white/10 bg-white shadow-xl">
    <img
        src={image}
        alt={name}
        class="h-48 w-full object-cover"
    />
    <div class="p-4">
        <h2 class="text-lg font-semibold text-gray-900">
            {name}
        </h2>
        <p class="mt-1 text-sm text-gray-500">
            {description}
        </p>
        <p class="mt-3 text-lg font-bold text-amber-700">
            C$ {price}
        </p>
    </div>
</article>