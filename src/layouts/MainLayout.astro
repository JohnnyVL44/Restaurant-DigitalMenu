---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Menú Digital' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Consulta nuestro menú digital." />
    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-gradient-to-br from-[#171717] via-[#292524] to-[#9a3412] text-white">
    <div class="mx-auto max-w-6xl px-6 py-8">
      <Header />

      <main>
        <slot />
      </main>

      <Footer />
    </div>
  </body>
</html>