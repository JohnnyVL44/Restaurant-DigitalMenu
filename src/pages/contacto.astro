---
import MainLayout from '../layouts/MainLayout.astro';

---

<MainLayout title="Nosotros">
    <main class="max-w-4xl mx-auto px-6 py-16">
        <section class="text-center mb-12">
            <h1 class="text-4xl font-bold mb-4">
                Contáctanos
            </h1>

            <p class="text-gray-600">
                Estamos aquí para atenderte. ¡Será un placer recibirte!
            </p>
        </section>

        <section class="grid md:grid-cols-2 gap-10">
            <div class="space-y-6">
                <div>
                    <h2 class="font-semibold text-lg mb-2">
                        📍 Dirección
                    </h2>
                    <p class="text-gray-600">
                        Managua, Nicaragua
                    </p>
                </div>

                <div>
                    <h2 class="font-semibold text-lg mb-2">
                        📞 Teléfono
                    </h2>
                    <p class="text-gray-600">
                        +505 8888-8888
                    </p>
                </div>

                <div>
                    <h2 class="font-semibold text-lg mb-2">
                        🕒 Horario
                    </h2>
                    <p class="text-gray-600">
                        Lunes a domingo: 10:00 AM - 9:00 PM
                    </p>
                </div>
            </div>

            <form class="space-y-4">
                <input
                    type="text"
                    placeholder="Tu nombre"
                    class="w-full border rounded-lg p-3"
                />

                <input
                    type="email"
                    placeholder="Tu correo electrónico"
                    class="w-full border rounded-lg p-3"
                />

                <textarea
                    placeholder="Escribe tu mensaje"
                    rows="5"
                    class="w-full border rounded-lg p-3"
                ></textarea>

                <button
                    type="submit"
                    class="w-full bg-black text-white py-3 rounded-lg hover:bg-gray-800 transition"
                >
                    Enviar mensaje
                </button>
            </form>
        </section>
    </main>

</MainLayout>