---
import MainLayout from '../layouts/MainLayout.astro';

---

<MainLayout title="Nosotros">
    <main class="max-w-5xl mx-auto px-6 py-16">
        <section class="text-center mb-16">
            <h1 class="text-4xl font-bold mb-6">
                Nuestra historia
            </h1>

            <p class="text-gray-600 max-w-2xl mx-auto leading-relaxed">
                Somos un restaurante dedicado a ofrecer experiencias
                gastronómicas únicas, combinando ingredientes frescos,
                sabores auténticos y un ambiente acogedor.
            </p>
        </section>

        <section class="grid md:grid-cols-2 gap-10 items-center">
            <div>
                <h2 class="text-2xl font-semibold mb-4">
                    Nuestra filosofía
                </h2>

                <p class="text-gray-600 leading-relaxed">
                    Creemos que la buena comida reúne a las personas.
                    Por eso, trabajamos cada día para ofrecer platos
                    preparados con dedicación y productos de calidad.
                </p>
            </div>

            <div class="bg-gray-100 rounded-xl p-10 text-center">
                <span class="text-6xl">🍽️</span>
                <p class="mt-4 text-gray-500">
                    Calidad, sabor y tradición.
                </p>
            </div>
        </section>
    </main>

</MainLayout>
